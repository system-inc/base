{
    "name": "base",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "description": "Modular framework for building Cloudflare Worker-based applications",
    "workspaces": [
        "packages/*",
        "examples"
    ],
    "base": {
        "workersFolder": "./examples"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks",
        "build": "npm run build --workspace @system-inc/base-cli",
        "dist": "node dist.mjs",
        "publish:local": "node scripts/publish-local.mjs",
        "publish:npmjs": "node scripts/publish-npmjs.mjs",
        "publish:github": "node scripts/publish-github.mjs",
        "reference:generate": "node scripts/reference-gen/generate.mjs",
        "dev": "tsc -p tsconfig.typecheck.json --watch",
        "clean": "rm -rf dist packages/*/dist packages/*/*.tsbuildinfo examples/.tsbuild",
        "typecheck": "tsc -p tsconfig.typecheck.json && npm run typecheck:worker && echo \"✓ Typecheck passed\"",
        "typecheck:worker": "tsc -p tsconfig.worker-check.json && echo \"✓ Worker-purity check passed (web-standards only, no Node in worker code)\"",
        "ci": "npm run clean && npm run typecheck && npm run build && npm run lint && npm run format:check && npm run test && npm run base -- check --all-workers",
        "base": "node ./packages/cli/dist/base-cli.js",
        "test": "jest",
        "test:integration": "npm run base -- test --all-workers",
        "lint": "eslint . && echo \"✓ Lint passed\"",
        "format": "prettier --write \"**/*.{js,ts,mjs,json,md}\"",
        "format:check": "prettier --check \"**/*.{js,ts,mjs,json,md}\""
    },
    "devDependencies": {
        "@cloudflare/containers": "^0.1.1",
        "@cloudflare/workers-types": "^4.20260604.1",
        "@eslint/js": "^9.16.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@planetscale/database": "^1.18.0",
        "@system-inc/base-lint": "*",
        "@system-inc/nexus": "^1.0.0",
        "@system-inc/type-graphql": "2.0.0-rc.3",
        "@types/better-sqlite3": "^7.6.13",
        "@types/jest": "^29.5.4",
        "@types/node": "^22.19.15",
        "@types/ws": "^8.5.12",
        "@typescript-eslint/utils": "^8.18.0",
        "@whatwg-node/server": "^0.9.19",
        "better-sqlite3": "^9.6.0",
        "drizzle-kit": "^0.31.10",
        "drizzle-orm": "^0.45.2",
        "eslint": "^9.16.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-boundaries": "^6.0.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^14.0.0",
        "graphql": "^16.0.0",
        "graphql-request": "^7.4.0",
        "graphql-scalars": "^1.24.0",
        "graphql-type-json": "^0.3.2",
        "graphql-yoga": "^4.0.4",
        "itty-router": "^5.0.17",
        "jest": "^29.6.4",
        "prettier": "^3.2.1",
        "reflect-metadata": "^0.2.0",
        "ts-jest": "^29.1.1",
        "tsyringe": "^4.8.0",
        "typedoc": "^0.28.2",
        "typescript": "^5.5.2",
        "typescript-eslint": "^8.18.0",
        "wrangler": "^4.32.0",
        "ws": "^8.18.0"
    },
    "engines": {
        "node": ">=22.12"
    }
}
