# npm-managed — don't reformat
package-lock.json
package.json

# The per-database drizzle/ tree is base-generated/managed (config,
# schema.generated.ts, migrations, release.ts, introspect output). Don't reformat
# it — notably schema.generated.ts, which `base orm schema:check` compares
# byte-for-byte against the raw generator output (reformatting = false drift).
**/database/**/drizzle/**

# Generated GraphQL output (`base graphql generate`) — SDL + optional --metadata
# JSON. Generator-owned and byte-compared by the gql schema check; don't reformat.
**/graphql/schemas/**
