{
    "name": "{{workspaceName}}",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "base": "node ./node_modules/@system-inc/base-cli/dist/base-cli.js",
        "test": "jest --passWithNoTests",
        "test:integration": "npm run base -- test --all-workers",
        "lint": "eslint . && echo \"✓ Lint passed\"",
        "format": "prettier --write \"**/*.{ts,js,mjs,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,js,mjs,json,md}\"",
        "clean": "rm -rf coverage workers/*/build workers/*/container/dist",
        "typecheck": "tsc --noEmit && echo \"✓ Typecheck passed\"",
        "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test"
    },
    "base": {
        "workersFolder": "./workers",
        "persistTo": "./.wrangler/state"
    },
    "dependencies": {
        "@system-inc/base-cli": "^{{baseVersion}}",
        "@system-inc/base-client": "^{{baseVersion}}",
        "@system-inc/base-common": "^{{baseVersion}}",
        "@system-inc/base-foundation": "^{{baseVersion}}",
        "@system-inc/type-graphql": "^2.0.0-rc.3",
        "drizzle-orm": "^0.45.0",
        "graphql": "^16.0.0",
        "graphql-yoga": "^4.0.0",
        "itty-router": "^5.0.0",
        "reflect-metadata": "^0.2.0",
        "tsyringe": "^4.8.0"
    },
    "devDependencies": {
        "@system-inc/base-lint": "^{{baseVersion}}",
        "@system-inc/nexus": "^1.0.0",
        "@cloudflare/workers-types": "^4.20241022.0",
        "@eslint/js": "^9.16.0",
        "@types/jest": "^29.5.4",
        "@types/node": "^22.0.0",
        "@types/ws": "^8.5.12",
        "drizzle-kit": "^0.31.0",
        "esbuild": "^0.25.0",
        "eslint": "^9.16.0",
        "graphql-request": "^7.4.0",
        "jest": "^29.6.4",
        "prettier": "^3.2.1",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.5.0",
        "typescript-eslint": "^8.18.0",
        "wrangler": "~4.105.0",
        "ws": "^8.18.0"
    },
    "engines": {
        "node": ">=22.12"
    }
}
