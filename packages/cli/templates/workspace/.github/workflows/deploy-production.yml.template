name: Deploy Production

# Promotes the workers to Production. Gated by a successful Integration
# Test run — if integration tests fail on a push to main, production
# deploy doesn't fire.
#
# Also available via manual dispatch for hotfix paths (use with care).

on:
    workflow_run:
        workflows: ['Integration Test']
        types: [completed]
        branches: [main]
    workflow_dispatch:

jobs:
    deploy-production:
        runs-on: ubuntu-latest

        # Only deploy when the upstream workflow actually succeeded.
        # workflow_run fires on any completion (success, failure,
        # cancelled) so we have to filter explicitly.
        if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}

        # Queue production deploys; never cancel one mid-flight, which can
        # leave some workers on the new release and some on the old.
        concurrency:
            group: deploy-production
            cancel-in-progress: false

        steps:
            # Deploy exactly the commit Integration tested. A bare checkout
            # on workflow_run takes the default branch's latest commit, which
            # may be newer and untested. (github.sha covers manual dispatch.)
            - uses: actions/checkout@v4
              with:
                  ref: ${{ github.event.workflow_run.head_sha || github.sha }}

            - name: Setup Node
              uses: actions/setup-node@v4
              with:
                  node-version: 22
                  cache: npm

            - name: Install dependencies
              run: npm ci

            - name: Configure project (import env.toml secrets)
              uses: ./.github/actions/configure-project
              with:
                  env-toml: ${{ secrets.ENV_TOML }}
                  test-env-toml: ${{ secrets.TEST_ENV_TOML }}

            - name: Deploy workers to Production
              run: npm run base -- deploy --environment Production --all-workers
