name: CI

on:
    push:
        branches: [main]
    pull_request:
        branches: [main]

jobs:
    build:
        runs-on: ubuntu-latest
        steps:
            - uses: actions/checkout@v4

            - name: Setup Node
              uses: actions/setup-node@v4
              with:
                  node-version: 22
                  cache: npm

            - name: Install dependencies
              run: npm ci

            # Hermetic — no env secrets needed. Environment-dependent
            # validation (`base check`) runs as a deploy gate, where an
            # environment is actually chosen.
            - name: Typecheck, lint, format, test
              run: npm run ci
