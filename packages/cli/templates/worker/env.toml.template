# Per-worker environment variables, keyed by environment. This file is
# gitignored — put secrets here without committing them. The `base` CLI loads
# the section matching the active environment, and `base deploy` uploads every
# value here as a Cloudflare secret (encrypted, hidden in the dashboard).
# Non-sensitive config you'd rather see in the dashboard belongs in
# wrangler.toml under [env.<Name>.vars] instead.
#
# Example:
#   [Development]
#   DATABASES = [{ name = "@default", url = "mysql://..." }]
#   MY_SECRET = "..."

