{
    "name": "@system-inc/base-common",
    "version": "1.0.0",
    "description": "Shared helpers and utilities for Base",
    "keywords": [
        "utilities",
        "helpers",
        "cloudflare-workers",
        "typescript",
        "base"
    ],
    "author": "System, Inc.",
    "sideEffects": false,
    "exports": {
        "./*": {
            "types": "./dist/*.d.ts",
            "default": "./source/*.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "LICENSE",
        "NOTICE",
        "dist",
        "!dist/.tsbuildinfo",
        "source",
        "!source/**/*.test.ts",
        "!source/**/CLAUDE.md"
    ],
    "scripts": {
        "clean": "rm -rf dist *.tsbuildinfo",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "prepack": "npm run build",
        "test": "jest --config ../../jest.config.js packages/common"
    },
    "dependencies": {
        "cron-parser": "^5.3.0",
        "decimal.js": "^10.4.3",
        "iso8601-duration": "^2.1.2"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20241022.0"
    },
    "peerDependencies": {
        "graphql": "^16.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/system-inc/base.git",
        "directory": "packages/common"
    },
    "homepage": "https://base-framework.dev",
    "bugs": {
        "url": "https://github.com/system-inc/base/issues"
    },
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    }
}
